          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT to_timestamp((ts_session_ms - MIN(ts_session_ms) OVER (PARTITION BY lap_number)) / 1000.0) AS \"time\", ('Lap ' || lap_number::text) AS metric, metric_value::double precision AS value FROM telemetry.telemetry_events WHERE session_id::text = '${session_id}' AND metric_key = 'Speed_Kmh' AND lap_number IS NOT NULL AND ts_wall_utc >= COALESCE((SELECT created_at_utc FROM telemetry.sessions WHERE session_id::text = '${session_id}'), now() - interval '6 hours') ORDER BY lap_number, ts_session_ms;",
          "refId": "A"
